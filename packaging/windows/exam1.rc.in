// Windows resources: application icon and version information.
// Template: CMake writes exam1.rc with the version of CMakeLists.txt (project VERSION).
#include <winver.h>

IDI_ICON1 ICON "@EXAM1_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "Exam'1 Community"
            VALUE "FileDescription", "Exam'1 - entrainement a l'examen radioamateur"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "exam1"
            VALUE "OriginalFilename", "exam1.exe"
            VALUE "ProductName", "Exam'1"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40c, 1200
    END
END
